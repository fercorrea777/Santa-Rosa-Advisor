# CLAVE DE ACCESO AL TABLERO. Sin esto la app queda ABIERTA a cualquiera que
# tenga la URL, y cada pantalla muestra una franja roja avisandolo. Es una
# clave compartida de equipo, no una cuenta por persona. Ver src/proxy.ts.
#
# Ademas de dejar entrar, FIRMA la cookie de sesion (lib/auth/sesion.ts):
# cambiarla cierra todas las sesiones abiertas, que es lo que uno espera al
# rotar una clave compartida.
#
# En produccion se define en el entorno de Coolify, NO en el repo.
# Generar una: `openssl rand -base64 24`
ADVISOR_CLAVE=...

# Opcional: por defecto la app ya encuentra la base y la config relativas a
# "../SANTA ROSA COMERCIAL ADVISOR/CADAM/". Solo sobreescribir si se mueve
# esa carpeta o se corre la app desde otro lugar.

# CADAM_DB_PATH=../SANTA ROSA COMERCIAL ADVISOR/CADAM/data/cadam.db
# CADAM_PARAMETROS_PATH=../SANTA ROSA COMERCIAL ADVISOR/CADAM/parametros.json

# El Copiloto ya NO usa Anthropic: corre con Gemma 4 en el Ollama del propio
# servidor (ver src/lib/copiloto/ollama.ts). Estas tres son opcionales y solo
# para pisar los valores por defecto.
# COPILOTO_OLLAMA_URL=http://10.0.1.1:11434   # se detecta solo si falta
# COPILOTO_MODELO=gemma4-hermes:latest
# COPILOTO_CTX=16384                          # subirlo sin medir tira el modelo a CPU

# Sigue haciendo falta para el job semanal de informes de competencia, que
# usa la API de Anthropic aparte del Copiloto.
ANTHROPIC_API_KEY=sk-ant-...

# Requerido para los informes de competencia (tabla Postgres nueva,
# separada de la base SQLite de solo lectura). Traer con
# `vercel env pull .env.local` una vez aprovisionada la base en el
# dashboard de Vercel (Storage → Postgres).
POSTGRES_URL=postgres://...

# Requerido para el job semanal: secreto que valida que la ruta
# /api/informes-competencia/generar solo la dispare el cron de Vercel.
# Generar uno propio, ej.: `openssl rand -hex 32`.
CRON_SECRET=...

# Secreto que valida los push de Hermes (base de conocimiento de competencia
# y operacion propia del API de Cars). Los endpoints que lo usan quedan
# FUERA de la clave del tablero, porque traen su propio bearer.
HERMES_INGEST_SECRET=...

# Correos del tablero: el enlace de "olvidé mi clave", las invitaciones y los
# reset que manda un admin. En produccion es la casilla de Google Workspace
# bitrix@santarosa.com.py (clave de aplicacion), copiada al entorno de
# Coolify desde el servidor. Sin SMTP_HOST, los enlaces se muestran en
# pantalla al admin y "olvide mi clave" avisa que no esta configurado.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bitrix@santarosa.com.py
SMTP_PASS=...
SMTP_FROM="Santa Rosa Advisor <bitrix@santarosa.com.py>"
# Con que dominio se arman los enlaces de los correos.
APP_URL=https://advisor.santarosa.lat
# Dominio de correo de la empresa: todo usuario tiene que ser nombre@este.
# ADVISOR_DOMINIO_CORREO=santarosa.com.py
